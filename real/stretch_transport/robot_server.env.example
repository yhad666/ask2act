# Optional environment file loaded by run_robot_server.sh if you copy this to:
#   real/stretch_transport/robot_server.env

# Bind endpoint for the REP server.
# ASK2ACT_STRETCH_SERVER_BIND=tcp://0.0.0.0:5557

# Command timeout in seconds for hook scripts or external commands.
# ASK2ACT_STRETCH_SERVER_COMMAND_TIMEOUT_S=180

# By default the server launches the bundled hook scripts in command mode.
# You can keep that and either edit the hook files directly or forward to your own scripts.
# ASK2ACT_STRETCH_SERVER_OBSERVE_MODE=command
# ASK2ACT_STRETCH_SERVER_EXECUTE_MODE=command

# The bundled observation path now tries to capture from the head D435i first.
# Set the known D435i serial when available:
# ASK2ACT_STRETCH_D435I_SERIAL=239122073910
# ASK2ACT_STRETCH_CAMERA_WIDTH=1280
# ASK2ACT_STRETCH_CAMERA_HEIGHT=720
# ASK2ACT_STRETCH_CAMERA_FPS=15
# ASK2ACT_STRETCH_CAPTURE_DEPTH=1
# ASK2ACT_STRETCH_INIT_HEAD_POSE_ON_START=1
# ASK2ACT_STRETCH_INIT_HEAD_POSE_MODE=every_observe
# ASK2ACT_STRETCH_INIT_HEAD_POSE_REQUIRED=1
# ASK2ACT_STRETCH_INIT_HEAD_PAN_RAD=-1.57
# ASK2ACT_STRETCH_INIT_HEAD_TILT_RAD=-0.55
# ASK2ACT_STRETCH_INIT_HEAD_SETTLE_S=2.0
# ASK2ACT_STRETCH_INIT_HEAD_TOLERANCE_RAD=0.15
#
# Only enable this if you explicitly want a fake image fallback during debugging:
# ASK2ACT_STRETCH_ALLOW_SAMPLE_FALLBACK=1
#
# If you want the observe hook to serve a fixed image while wiring things up:
# ASK2ACT_STRETCH_OBSERVATION_IMAGE_PATH=/abs/path/to/latest_rgb.png

# The bundled execute path now accepts dry-runs directly and will execute a real
# waypoint trajectory if the request contains grasp_plan.trajectory and stretch_body
# is available on the robot.
#
# Preferred lab-specific integration:
# point these at your own observation / execution scripts if you already have them.
# Each command receives two positional args:
#   1. request JSON path
#   2. response JSON path
#
# ASK2ACT_STRETCH_OBSERVE_FORWARD_COMMAND="python /abs/path/to/capture_observation.py"
# ASK2ACT_STRETCH_EXECUTE_FORWARD_COMMAND="python /abs/path/to/dispatch_grasp.py"
