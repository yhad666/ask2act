# Ask2Act Stretch-side transport config for stretch-se3-3056

# Bind the REP server on the robot.
ASK2ACT_STRETCH_SERVER_BIND=tcp://0.0.0.0:5557
ASK2ACT_STRETCH_SERVER_COMMAND_TIMEOUT_S=120
ASK2ACT_STRETCH_SERVER_OBSERVE_TIMEOUT_S=90
ASK2ACT_STRETCH_SERVER_EXECUTE_TIMEOUT_S=115
ASK2ACT_STRETCH_BASE_ROTATE_EPS_RAD=0.02
ASK2ACT_STRETCH_BASE_ROTATE_MAX_DELTA_RAD=0.40
ASK2ACT_STRETCH_BASE_ROTATE_WAIT_TIMEOUT_S=12.0
ASK2ACT_STRETCH_BASE_ROTATE_RETURN_WAIT_TIMEOUT_S=3.0
ASK2ACT_STRETCH_BASE_ROTATE_WAIT_TOLERANCE_RAD=0.035
ASK2ACT_STRETCH_EXECUTE_DEADLINE_S=90
ASK2ACT_STRETCH_REQUIRED_WAIT_JOINTS=lift,arm,wrist_yaw,wrist_pitch,wrist_roll,base_rotate,base_translate_forward,base_translate_arm_axis,stretch_gripper
ASK2ACT_STRETCH_WAYPOINT_SETTLE_S=0.4
ASK2ACT_STRETCH_JOINT_WAIT_TIMEOUT_S=20.0
ASK2ACT_STRETCH_LIFT_WAIT_TIMEOUT_S=25.0
ASK2ACT_STRETCH_ARM_WAIT_TIMEOUT_S=25.0
ASK2ACT_STRETCH_WRIST_WAIT_TIMEOUT_S=20.0
ASK2ACT_STRETCH_GRIPPER_WAIT_TIMEOUT_S=8.0
ASK2ACT_STRETCH_WAIT_TOLERANCE_LIFT=0.025
ASK2ACT_STRETCH_WAIT_TOLERANCE_ARM=0.025
ASK2ACT_STRETCH_WAIT_TOLERANCE_WRIST_YAW=0.05
ASK2ACT_STRETCH_WAIT_TOLERANCE_WRIST_PITCH=0.04
ASK2ACT_STRETCH_WAIT_TOLERANCE_WRIST_ROLL=0.05
ASK2ACT_STRETCH_WAIT_TOLERANCE_GRIPPER=5.0
ASK2ACT_STRETCH_DESCEND_WAIT_TIMEOUT_S=25.0
ASK2ACT_STRETCH_DESCEND_LIFT_TOLERANCE_M=0.018
ASK2ACT_STRETCH_NONFATAL_CLEANUP_WAIT_FAILURES=1
ASK2ACT_STRETCH_NONFATAL_CLEANUP_WAYPOINTS=retract_arm_after_grasp,return_base_rotate_after_grasp
ASK2ACT_STRETCH_NONFATAL_CLEANUP_JOINTS=arm
ASK2ACT_STRETCH_FAST_CLEANUP_WAYPOINTS=retract_arm_after_grasp,return_base_rotate_after_grasp
ASK2ACT_STRETCH_CLEANUP_JOINT_WAIT_TIMEOUT_S=2.0
ASK2ACT_STRETCH_CLEANUP_BASE_ROTATE_WAIT_TIMEOUT_S=3.0
ASK2ACT_STRETCH_CLEANUP_WAYPOINT_MAX_SETTLE_S=0.25
ASK2ACT_STRETCH_GRIPPER_OPEN_ACCEPT_PCT=80.0
ASK2ACT_STRETCH_GRIPPER_CLOSE_ACCEPT_PCT=70.0
ASK2ACT_STRETCH_GRIPPER_OPEN_ACCEPT_POS=80.0
ASK2ACT_STRETCH_GRIPPER_OPEN_ACCEPT_PLANNER_POS=0.45
ASK2ACT_STRETCH_GRIPPER_CLOSE_ACCEPT_POS=0.05
ASK2ACT_STRETCH_GRIPPER_COMMAND_MODE=real_pct
ASK2ACT_STRETCH_GRIPPER_REAL_OPEN_CMD=100.0
ASK2ACT_STRETCH_GRIPPER_REAL_CLOSE_CMD=-50.0
ASK2ACT_STRETCH_GRIPPER_PLANNER_OPEN_THRESHOLD=0.5
ASK2ACT_STRETCH_GRIPPER_PLANNER_CLOSE_THRESHOLD=-0.3

# Return the manipulator to a repeatable camera-safe pose before every camera
# capture/video start, then to the normal start/end poses around execution.
# After a successful trajectory, the base rotates back, the arm/wrist return to
# the low camera-safe pose, then the gripper opens so Stretch does not hold the
# object while waiting for web confirmation.
ASK2ACT_STRETCH_HOME_POSE_ON_OBSERVE=1
ASK2ACT_STRETCH_HOME_POSE_ON_EXECUTE_START=1
ASK2ACT_STRETCH_HOME_POSE_ON_EXECUTE_END=1
ASK2ACT_STRETCH_HOME_POSE_REQUIRED=1
ASK2ACT_STRETCH_HOME_LIFT_M=0.50
ASK2ACT_STRETCH_HOME_LIFT_OBSERVE_START_M=0.45
ASK2ACT_STRETCH_HOME_LIFT_EXECUTE_END_M=0.45
ASK2ACT_STRETCH_HOME_ARM_M=0.0
ASK2ACT_STRETCH_HOME_WRIST_YAW_RAD=0.0
ASK2ACT_STRETCH_HOME_WRIST_PITCH_RAD=-1.57
ASK2ACT_STRETCH_HOME_WRIST_ROLL_RAD=0.0
ASK2ACT_STRETCH_HOME_GRIPPER_CMD=100.0
ASK2ACT_STRETCH_HOME_GRIPPER_ON_OBSERVE=0
ASK2ACT_STRETCH_HOME_GRIPPER_ON_EXECUTE_START=0
ASK2ACT_STRETCH_HOME_GRIPPER_ON_EXECUTE_END=0
ASK2ACT_STRETCH_HOME_POSE_ON_EXECUTE_FAILURE=1
ASK2ACT_STRETCH_HOME_GRIPPER_ON_EXECUTE_FAILURE=0
ASK2ACT_STRETCH_HOME_SETTLE_S=2.0
ASK2ACT_STRETCH_HOME_SETTLE_OBSERVE_START_S=1.2
ASK2ACT_STRETCH_HOME_VERIFY_ON_OBSERVE=1
ASK2ACT_STRETCH_HOME_OBSERVE_VERIFY_JOINTS=lift,arm
ASK2ACT_STRETCH_HOME_OBSERVE_VERIFY_TIMEOUT_S=10.0
ASK2ACT_STRETCH_HOME_VERIFY_TOLERANCE_LIFT=0.035
ASK2ACT_STRETCH_HOME_VERIFY_TOLERANCE_ARM=0.025
ASK2ACT_STRETCH_HOME_SETTLE_EXECUTE_END_S=0.4
ASK2ACT_STRETCH_RETURN_BASE_ROTATE_ON_EXECUTE_END=1
ASK2ACT_STRETCH_RETURN_BASE_ROTATE_BEFORE_HOME_ON_EXECUTE_END=1
ASK2ACT_STRETCH_RELEASE_GRIPPER_ON_EXECUTE_END=1
ASK2ACT_STRETCH_RELEASE_GRIPPER_VERIFY=0
ASK2ACT_STRETCH_RELEASE_GRIPPER_WAIT_TIMEOUT_S=0.0
ASK2ACT_STRETCH_RELEASE_GRIPPER_SETTLE_S=0.2

# Keep the default command-mode hooks.
ASK2ACT_STRETCH_SERVER_OBSERVE_MODE=command
ASK2ACT_STRETCH_SERVER_EXECUTE_MODE=command

# Head D435i capture
ASK2ACT_STRETCH_D435I_SERIAL=239122073910
ASK2ACT_STRETCH_CAMERA_WIDTH=1280
ASK2ACT_STRETCH_CAMERA_HEIGHT=720
ASK2ACT_STRETCH_CAMERA_FPS=15
ASK2ACT_STRETCH_CAPTURE_DEPTH=1
ASK2ACT_STRETCH_OBSERVE_FROM_VIDEO_STREAM=1
ASK2ACT_STRETCH_VIDEO_WIDTH=1280
ASK2ACT_STRETCH_VIDEO_HEIGHT=720
ASK2ACT_STRETCH_VIDEO_FPS=10
ASK2ACT_STRETCH_VIDEO_CHUNK_BYTES=4194304
ASK2ACT_STRETCH_VIDEO_INIT_HEAD_POSE_ON_START=1

# Before each observation, point the head D435i toward the tabletop, verify that
# it settled near the commanded pose, and only then continue to capture.
ASK2ACT_STRETCH_INIT_HEAD_POSE_ON_START=1
ASK2ACT_STRETCH_INIT_HEAD_POSE_MODE=every_observe
ASK2ACT_STRETCH_INIT_HEAD_POSE_REQUIRED=1
ASK2ACT_STRETCH_INIT_HEAD_PAN_RAD=-1.57
ASK2ACT_STRETCH_INIT_HEAD_TILT_RAD=-0.68
ASK2ACT_STRETCH_INIT_HEAD_SETTLE_S=2.0
ASK2ACT_STRETCH_INIT_HEAD_TOLERANCE_RAD=0.15

# Keep this off for real bring-up. Enable only if you explicitly want a fake
# image when the camera path fails.
ASK2ACT_STRETCH_ALLOW_SAMPLE_FALLBACK=0

# If you need to force a static observation image during debugging, set this.
# ASK2ACT_STRETCH_OBSERVATION_IMAGE_PATH=/abs/path/to/latest_rgb.png

# If your lab has a custom observation / execution stack, point these at it.
# ASK2ACT_STRETCH_OBSERVE_FORWARD_COMMAND="python /abs/path/to/capture_observation.py"
# ASK2ACT_STRETCH_EXECUTE_FORWARD_COMMAND="python /abs/path/to/dispatch_grasp.py"

# Allow small base reach corrections generated by the A6000 planner when the
# arm alone would be at its extension limit.
ASK2ACT_STRETCH_BASE_TRANSLATE_FORWARD_ENABLED=1
ASK2ACT_STRETCH_BASE_TRANSLATE_FORWARD_MAX_M=0.10
ASK2ACT_STRETCH_BASE_TRANSLATE_FORWARD_TIMEOUT_S=8.0
ASK2ACT_STRETCH_BASE_TRANSLATE_ARM_AXIS_ENABLED=1
ASK2ACT_STRETCH_BASE_TRANSLATE_ARM_AXIS_MAX_M=0.18
ASK2ACT_STRETCH_BASE_TRANSLATE_ARM_AXIS_TIMEOUT_S=8.0
ASK2ACT_STRETCH_BASE_TRANSLATE_ARM_AXIS_ROTATE_TIMEOUT_S=8.0
ASK2ACT_STRETCH_BASE_TRANSLATE_TOLERANCE_M=0.02
ASK2ACT_STRETCH_BASE_TRANSLATE_ROTATE_TOLERANCE_RAD=0.035
