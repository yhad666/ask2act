# Optional environment file for services/a6000_web/run_real_service.sh

# MiMo / VLM
# ASK2ACT_VLLM_BASE_URL=http://127.0.0.1:8000/v1
# ASK2ACT_VLLM_MODEL=mimo-vl

# Detection + clarification
# ASK2ACT_DETECTOR_DEVICE=cuda:1
# ASK2ACT_DINO_BOX_THRESHOLD=0.38
# ASK2ACT_DINO_TEXT_THRESHOLD=0.30
# ASK2ACT_DINO_ROTATE_CLOCKWISE_90=1
# ASK2ACT_GEN_MAX_TOKENS=4096
# ASK2ACT_GEN_MAX_TOKENS_CAP=4096
# ASK2ACT_THINK_HINT=1

# Real robot transport
# ASK2ACT_STRETCH_TRANSPORT=zmq
# ASK2ACT_STRETCH_ZMQ_ENDPOINT=tcp://stretch-se3-3056.local:5557
# ASK2ACT_STRETCH_TIMEOUT_MS=120000
# ASK2ACT_STRETCH_OBSERVE_TIMEOUT_MS=120000
# ASK2ACT_STRETCH_EXECUTE_TIMEOUT_MS=130000

# Real point-cloud planning from the latest Stretch RGB-D observation.
# ASK2ACT_PIPELINE_MODE=mock
# ASK2ACT_PIPELINE_MODE=local_sim
# ASK2ACT_PIPELINE_MODE=real_pointcloud
# ASK2ACT_HEAD_CAMERA_EXTRINSICS_PATH=/abs/path/to/head_camera_extrinsics.json
# Real top-down execution should use SimpleIK. Enable the approximate fallback
# only for deliberate debugging, not for normal cup grasping.
# ASK2ACT_REAL_ALLOW_APPROXIMATE_TOPDOWN_FALLBACK=0
# Fallback-only overrides for deliberate debugging.
# ASK2ACT_APPROX_GEOMETRIC_TOP_DOWN_WRIST_Z_OFFSET_M=0.10
# ASK2ACT_APPROX_GEOMETRIC_TOP_DOWN_X_CORRECTION_M=0.045
# ASK2ACT_APPROX_GEOMETRIC_TOP_DOWN_Y_CORRECTION_M=0.0
# ASK2ACT_GEOMETRIC_TOP_DOWN_GRIPPER_OPEN_CMD_OVERRIDE=0.56
# ASK2ACT_REAL_TABLE_TOP_Z_M=auto
# ASK2ACT_REAL_TABLE_CLEARANCE_MARGIN_M=0.005
# ASK2ACT_REAL_OBJECT_Z_MAX_ABOVE_TABLE_M=0.22
# ASK2ACT_GEOMETRIC_TOP_DOWN_GRASP_Z_MODE=center
# ASK2ACT_GEOMETRIC_TOP_DOWN_GRASP_TOP_CLEARANCE_M=0.0
# SimpleIK real-contact correction for calibrated top-down rubber contact.
# Negative local Y reduces the solved arm extension when the real gripper
# reaches farther outward than the simulation model.
# ASK2ACT_GEOMETRIC_TOP_DOWN_RUBBER_LOCAL_X_CORRECTION_M=0.0
# ASK2ACT_GEOMETRIC_TOP_DOWN_RUBBER_LOCAL_Y_CORRECTION_M=-0.045
# ASK2ACT_GEOMETRIC_TOP_DOWN_RUBBER_LOCAL_Z_CORRECTION_M=0.0
# ASK2ACT_GEOMETRIC_TOP_DOWN_SLENDER_RUBBER_LOCAL_X_CORRECTION_M=0.0
# ASK2ACT_GEOMETRIC_TOP_DOWN_SLENDER_RUBBER_LOCAL_Y_CORRECTION_M=0.0
# ASK2ACT_GEOMETRIC_TOP_DOWN_SLENDER_RUBBER_LOCAL_Z_CORRECTION_M=0.0
# ASK2ACT_GEOMETRIC_TOP_DOWN_SIDE_X_BIAS_M=0.02
# ASK2ACT_GEOMETRIC_TOP_DOWN_SIDE_X_BIAS_DEADBAND_M=0.05
# ASK2ACT_GEOMETRIC_TOP_DOWN_RIGHT_EXTRA_X_BIAS_M=0.01
# ASK2ACT_GEOMETRIC_TOP_DOWN_LEFT_CENTER_Y_BIAS_M=0.005
# ASK2ACT_GEOMETRIC_TOP_DOWN_RIGHT_Y_BIAS_M=-0.005
# ASK2ACT_GEOMETRIC_TOP_DOWN_SLENDER_SIDE_X_BIAS_M=0.0
# ASK2ACT_GEOMETRIC_TOP_DOWN_SLENDER_SIDE_X_BIAS_DEADBAND_M=0.05
# ASK2ACT_GEOMETRIC_TOP_DOWN_SLENDER_RIGHT_EXTRA_X_BIAS_M=0.0
# ASK2ACT_GEOMETRIC_TOP_DOWN_SLENDER_LEFT_CENTER_Y_BIAS_M=0.0
# ASK2ACT_GEOMETRIC_TOP_DOWN_SLENDER_RIGHT_Y_BIAS_M=0.0
# ASK2ACT_GEOMETRIC_TOP_DOWN_MAX_TOP_GRASP_DELTA_M=0.07
# ASK2ACT_GEOMETRIC_TOP_DOWN_PREGRASP_CLEARANCE_M=0.15
# ASK2ACT_GEOMETRIC_TOP_DOWN_POSTGRASP_LIFT_M=0.30
# ASK2ACT_GEOMETRIC_TOP_DOWN_RETURN_BASE_ROTATE_TO_START=1
# ASK2ACT_GEOMETRIC_TOP_DOWN_SIMPLEIK_MAX_FK_ERROR_M=0.025
# ASK2ACT_GEOMETRIC_TOP_DOWN_ENABLE_BASE_REACH_TRANSLATE=1
# ASK2ACT_GEOMETRIC_TOP_DOWN_BASE_REACH_TRANSLATE_MAX_M=0.16
# ASK2ACT_GEOMETRIC_TOP_DOWN_BASE_REACH_TRANSLATE_MARGIN_M=0.02
# Base preposition is split into lateral base-forward motion and arm-axis
# motion. Keep both conservative because the A6000 reobserves and replans after.
# ASK2ACT_REAL_BASE_PREPOSITION_GOAL_DISTANCE_M=0.56
# ASK2ACT_REAL_BASE_PREPOSITION_CORRECTION_FRACTION=0.55
# ASK2ACT_REAL_BASE_PREPOSITION_LATERAL_MAX_M=0.06
# ASK2ACT_REAL_BASE_PREPOSITION_LONGITUDINAL_MAX_M=0.06
# ASK2ACT_REAL_BASE_PREPOSITION_LATERAL_DEADBAND_M=0.035
# ASK2ACT_REAL_BASE_PREPOSITION_LONGITUDINAL_DEADBAND_M=0.04
# ASK2ACT_REAL_REPLAN_AFTER_BASE_REACH=1
# ASK2ACT_REAL_BASE_REACH_REPLAN_MAX_ATTEMPTS=2
# Fail before moving the base if the first plan already needs more arm-axis
# prepositioning than the safe cumulative budget. This avoids moving Stretch
# several times only to fail after reobserve/replan.
# ASK2ACT_REAL_BASE_REACH_FAIL_FAST_OVERSIZED=1
# ASK2ACT_REAL_BASE_REACH_MAX_TOTAL_ARM_AXIS_M=0.15
# After base reach movement, reobserve and relock the original target using
# appearance + local layout; fail if the best two matches are closer than this.
# ASK2ACT_REOBSERVE_TARGET_LOCK_AMBIGUITY_MARGIN=0.02
# Keep online experiments operator-gated. The /online console only executes
# after the resolved target matches the expected display id.
# ASK2ACT_AUTO_EXECUTE_ON_RESOLVE=0
# ASK2ACT_SESSION_RECORD_ROOT=/abs/path/to/session_records
# ASK2ACT_OFFLINE_EXPERIMENT_ROOT=/abs/path/to/offline_experiments
# ASK2ACT_ONLINE_EXPERIMENT_ROOT=/abs/path/to/online_experiments
# ASK2ACT_OFFLINE_MAX_ROUNDS=6
# ASK2ACT_ONLINE_MAX_ROUNDS=6
#
# Conservative low-profile slender-object grasping for forks/spoons. Cup and
# upright bottle grasps keep the original geometric policy unless the target
# point cloud is both low and strongly elongated.
# ASK2ACT_GEOMETRIC_SLENDER_OBJECT_ASPECT_RATIO=2.5
# ASK2ACT_GEOMETRIC_SLENDER_OBJECT_MAX_HEIGHT_M=0.065
# ASK2ACT_GEOMETRIC_SLENDER_GRIP_CLEARANCE_M=0.018
# ASK2ACT_GEOMETRIC_SLENDER_MIN_OPEN_WIDTH_M=0.032
# ASK2ACT_GEOMETRIC_SLENDER_GRASP_LONG_AXIS_BIAS=0.0

# Web service
# ASK2ACT_A6000_HOST=127.0.0.1
# ASK2ACT_A6000_PORT=7862
# ASK2ACT_A6000_PYTHON_BIN=python3
