# Ask2Act A6000 real-robot service config

# MiMo / VLM
ASK2ACT_VLLM_BASE_URL=http://127.0.0.1:8000/v1
ASK2ACT_VLLM_MODEL=mimo-vl

# Detection + clarification
# Keep GPU 0 free for MiMo and run GroundingDINO on GPU 1.
ASK2ACT_DETECTOR_DEVICE=cuda:1
ASK2ACT_DINO_BOX_THRESHOLD=0.38
ASK2ACT_DINO_TEXT_THRESHOLD=0.30
ASK2ACT_DINO_ROTATE_CLOCKWISE_90=1
ASK2ACT_GEN_MAX_TOKENS=8000
ASK2ACT_THINK_HINT=1

# Real robot transport
ASK2ACT_STRETCH_TRANSPORT=zmq
ASK2ACT_STRETCH_ZMQ_ENDPOINT=tcp://stretch-se3-3056.local:5557
ASK2ACT_STRETCH_TIMEOUT_MS=120000
ASK2ACT_STRETCH_OBSERVE_TIMEOUT_MS=120000
ASK2ACT_STRETCH_EXECUTE_TIMEOUT_MS=130000

# Real execution plan: use the latest Stretch head D435i depth frame, the
# resolved bbox, and the calibrated camera-to-world extrinsics to create the
# waypoint trajectory sent back to Stretch.
ASK2ACT_PIPELINE_MODE=real_pointcloud
ASK2ACT_HEAD_CAMERA_EXTRINSICS_PATH=/home/haoandong/ask2act/real/stretch_transport/head_camera_extrinsics.json
ASK2ACT_REAL_ALLOW_APPROXIMATE_TOPDOWN_FALLBACK=1
ASK2ACT_APPROX_GEOMETRIC_TOP_DOWN_WRIST_Z_OFFSET_M=0.0
ASK2ACT_REAL_TABLE_TOP_Z_M=auto
ASK2ACT_REAL_TABLE_CLEARANCE_MARGIN_M=0.005
ASK2ACT_REAL_OBJECT_Z_MAX_ABOVE_TABLE_M=0.22
ASK2ACT_AUTO_EXECUTE_ON_RESOLVE=1
ASK2ACT_SESSION_RECORD_ROOT=/home/haoandong/ask2act/services/a6000_web/artifacts/session_records

# Optional local grasp pipeline settings.
# ASK2ACT_SCENE_CONFIG_PATH=/home/haoandong/ask2act/simulation/ask2act_grasp/config/scene_config.yaml
# ASK2ACT_GRASP_CONFIG_PATH=/home/haoandong/ask2act/simulation/ask2act_grasp/config/grasp_config.yaml
# ASK2ACT_PIPELINE_RUN_ROOT=/home/haoandong/ask2act/simulation/logs/a6000_runs
ASK2ACT_PIPELINE_HEADLESS=1
ASK2ACT_PIPELINE_SHOW_VIEWER=0

# Web service
ASK2ACT_A6000_HOST=127.0.0.1
ASK2ACT_A6000_PORT=7862
ASK2ACT_A6000_PYTHON_BIN=python3
