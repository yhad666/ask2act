# Ask2Act A6000 real-robot service config

# MiMo / VLM
ASK2ACT_VLLM_BASE_URL=http://127.0.0.1:8000/v1
ASK2ACT_VLLM_MODEL=mimo-vl

# Detection + clarification
# Keep GPU 0 free for MiMo and run GroundingDINO on GPU 1.
ASK2ACT_DETECTOR_DEVICE=cuda:1
ASK2ACT_GEN_MAX_TOKENS=8000
ASK2ACT_THINK_HINT=1

# Real robot transport
ASK2ACT_STRETCH_TRANSPORT=zmq
ASK2ACT_STRETCH_ZMQ_ENDPOINT=tcp://stretch-se3-3056.local:5557
ASK2ACT_STRETCH_TIMEOUT_MS=30000

# Start safe first. Switch to local_sim only after stretch_mujoco and the
# local grasp stack are confirmed working on the A6000 host.
ASK2ACT_PIPELINE_MODE=mock
# ASK2ACT_PIPELINE_MODE=local_sim

# Optional local grasp pipeline settings for later bring-up.
# ASK2ACT_SCENE_CONFIG_PATH=/home/haoandong/ask2act/simulation/ask2act_grasp/config/scene_config.yaml
# ASK2ACT_GRASP_CONFIG_PATH=/home/haoandong/ask2act/simulation/ask2act_grasp/config/grasp_config.yaml
# ASK2ACT_PIPELINE_RUN_ROOT=/home/haoandong/ask2act/simulation/logs/a6000_runs
ASK2ACT_PIPELINE_HEADLESS=1
ASK2ACT_PIPELINE_SHOW_VIEWER=0

# Web service
ASK2ACT_A6000_HOST=127.0.0.1
ASK2ACT_A6000_PORT=7862
ASK2ACT_A6000_PYTHON_BIN=python3
