      <geom type="cylinder" pos="0 0 0.004" size="0.022 0.051" rgba="0.70 0.76 0.83 1"/>
    </body>

    <body name="plate" pos="0.09 -0.87 0.39">
      <geom type="cylinder" size="0.075 0.008" material="plate_mat"/>
