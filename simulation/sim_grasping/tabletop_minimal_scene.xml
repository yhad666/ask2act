    <body name="spoon" pos="-0.03 -1.05 0.386" euler="0 0 -0.58">
      <geom type="capsule" fromto="-0.06 0 0 -0.005 0 0" size="0.006" material="spoon_mat"/>
      <geom type="ellipsoid" pos="0.018 0 0" size="0.025 0.014 0.005" material="spoon_mat"/>
    </body>
  </worldbody>
</mujoco>
