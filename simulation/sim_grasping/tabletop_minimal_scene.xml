<mujoco model="stretch tabletop validation">
  <compiler angle="radian" assetdir="../stretch_mujoco/stretch_mujoco/models/assets"/>
  <include file="../stretch_mujoco/stretch_mujoco/models/stretch.xml"/>

  <statistic center="0 -0.8 0.8" extent="1.4" meansize="0.06"/>

  <visual>
