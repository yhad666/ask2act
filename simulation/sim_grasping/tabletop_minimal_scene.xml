    <light pos="0.6 -1.0 1.2" dir="-0.2 0.3 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="floor_mat"/>

    <body name="table" pos="0.0 -0.95 0.38">
